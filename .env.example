# Copy this file to .env. Only these two values are required to enable the Agent.
# Never commit a real key.
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible providers: uncomment and set the endpoint. Official OpenAI needs neither.
# Switch the API style only when the provider/model does not support Responses.
# LLM_BASE_URL=
# LLM_API_STYLE=responses

# Everything below is optional. Uncomment only when overriding a built-in default.

# Application paths
# APP_ENV=local
# DATABASE_PATH=var/minimal_agent.db
# MAINBOARD_DATA_PATH=data/mainboards.json
# SYSTEM_PROMPT_PATH=prompts/system.md
# SUMMARIZE_PROMPT_PATH=prompts/summarize.md

# Reasoning compatibility
# LLM_REASONING_CAPTURE=auto
# LLM_REASONING_OUTPUT=auto
# LLM_REASONING_EFFORT=medium
# LLM_REASONING_SUMMARY=auto
# LLM_THINK_TAG_ENABLED=true
# LLM_THINK_TAG_NAME=think

# Agent, network, tools, and context
# AGENT_MAX_STEPS=8
# AGENT_SHUTDOWN_GRACE_SECONDS=5
# USER_MESSAGE_MAX_CHARS=20000
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=3
# WEATHER_HTTP_TIMEOUT_SECONDS=5
# ORDER_TOOL_TIMEOUT_SECONDS=5
# CONTEXT_TRIGGER_RATIO=0.80
# RECENT_TURNS_TO_KEEP=5

# Streaming and SSE
# STREAM_FLUSH_BYTES=8192
# STREAM_FLUSH_INTERVAL_MS=100
# STREAM_QUEUE_MAXSIZE=256
# SSE_HEARTBEAT_SECONDS=15

# Paid live tests are opt-in. Uncomment only when intentionally spending API quota.
# RUN_LIVE_LLM_TESTS=1
# LIVE_TEST_PROFILE=smoke
# LIVE_MAX_LLM_CALLS=1
# LIVE_MAX_OUTPUT_TOKENS=64
# LIVE_EXPECT_TOOLS=true
# LIVE_EXPECT_REASONING=none
# LIVE_EXPECT_REASONING_SOURCE=either

