APP_ENV=local
DATABASE_PATH=var/minimal_agent.db
MAINBOARD_DATA_PATH=data/mainboards.json
SYSTEM_PROMPT_PATH=prompts/system.md
SUMMARIZE_PROMPT_PATH=prompts/summarize.md

# Generic OpenAI/OpenAI-compatible configuration. Never commit a real key.
# Leave LLM_BASE_URL empty for the official OpenAI endpoint.
# OPENAI_* and DEEPSEEK_* aliases remain accepted for backward compatibility.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_STYLE=responses
LLM_REASONING_CAPTURE=auto
LLM_REASONING_OUTPUT=auto
LLM_REASONING_EFFORT=
LLM_REASONING_SUMMARY=
LLM_THINK_TAG_ENABLED=true
LLM_THINK_TAG_NAME=think
LLM_MAX_OUTPUT_TOKENS=512

AGENT_MAX_STEPS=8
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_SHUTDOWN_GRACE_SECONDS=5
USER_MESSAGE_MAX_CHARS=20000
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=10
WEATHER_HTTP_TIMEOUT_SECONDS=5
CONTEXT_WINDOW_TOKENS=0
CONTEXT_TRIGGER_RATIO=0.80
RECENT_TURNS_TO_KEEP=5

STREAM_FLUSH_BYTES=8192
STREAM_FLUSH_INTERVAL_MS=100
STREAM_QUEUE_MAXSIZE=256
SSE_HEARTBEAT_SECONDS=15

# Paid live tests are opt-in. The full profile has a hard process-local call budget.
RUN_LIVE_LLM_TESTS=0
LIVE_TEST_PROFILE=smoke
LIVE_MAX_LLM_CALLS=8
LIVE_MAX_OUTPUT_TOKENS=1024
LIVE_EXPECT_TOOLS=true
LIVE_EXPECT_REASONING=none
LIVE_EXPECT_REASONING_SOURCE=either

